anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -260.0
offset_top = -156.0
offset_right = 260.0
offset_bottom = 156.0
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="VBox"]
